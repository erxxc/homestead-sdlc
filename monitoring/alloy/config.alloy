logging {
  level  = "info"
  format = "logfmt"
}

loki.write "local" {
  endpoint { url = "http://127.0.0.1:3100/loki/api/v1/push" }
}

loki.source.journal "system" {
  max_age    = "24h"
  labels     = { job = "systemd-journal", platform = "parallel-works" }
  forward_to = [loki.write.local.receiver]
}

local.file_match "parallel_works" {
  path_targets = [
    { __path__ = "/opt/minecraft/homestead/logs/latest.log", job = "minecraft", world = "homestead" },
    { __path__ = "/opt/minecraft/skyfactory4-4.2.4/logs/latest.log", job = "minecraft", world = "skyfactory" },
    { __path__ = "/var/log/minecraft-audit*.json", job = "minecraft-audit" },
    { __path__ = "/var/log/minecraft-backup-verify*.log", job = "backup-verify" },
    { __path__ = "/var/log/minecraft-backup-prune*.log", job = "backup-prune" },
    { __path__ = "/var/log/nginx/access.log", job = "nginx", stream = "access" },
    { __path__ = "/var/log/nginx/error.log", job = "nginx", stream = "error" },
  ]
}

loki.source.file "parallel_works" {
  targets       = local.file_match.parallel_works.targets
  forward_to    = [loki.write.local.receiver]
  tail_from_end = true
}
