[Unit]
Description=All of Create 2.6 isolated staging server
After=network-online.target
Wants=network-online.target
OnFailure=minecraft-alert@%p.service
Conflicts=minecraft-skyfactory4-staging.service

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft/releases/all-of-create/2.6
EnvironmentFile=/etc/minecraft/profiles/all-of-create-staging.env
EnvironmentFile=-/etc/minecraft/secrets/rcon
ExecStartPre=/usr/local/bin/minecraft-profile-validate
ExecStartPre=/usr/local/bin/verify-profile-mods
ExecStart=/usr/local/bin/minecraft-profile-launch
ExecStop=/bin/kill -s SIGINT $MAINPID
Restart=no
TimeoutStartSec=20min
TimeoutStopSec=180
MemoryMax=6G
OOMPolicy=stop
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/minecraft/releases/all-of-create/2.6 /opt/minecraft/backups/all-of-create-staging /var/log

[Install]
WantedBy=multi-user.target
