[Unit]
Description=Minecraft Exporter (SkyFactory)
After=network.target minecraft-skyfactory4-staging.service

[Service]
User=minecraft
EnvironmentFile=/etc/minecraft/secrets/rcon
ExecStart=/usr/local/bin/minecraft-exporter --web.listen-address=127.0.0.1:9226 --mc.rcon-address=localhost:25576 --mc.config-path=/opt/minecraft/exporter-config.yml --mc.world=/opt/minecraft/skyfactory4-4.2.4/world
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
