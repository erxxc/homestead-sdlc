# Deployed from security/mod-watcher.sh (installed as /usr/local/bin/mod-watcher)
[Unit]
Description=Minecraft Mod Directory Watcher
After=network.target
OnFailure=minecraft-alert@%p.service
# See minecraft-audit.service — without a widened start-limit window a
# crash-loop never reaches failed state and OnFailure never fires.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
User=minecraft
ExecStart=/usr/local/bin/mod-watcher
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
